# MiniMax M2.5 API Key (用於直接呼叫 MiniMax，如果需要的話)
# MINIMAX_API_KEY=your_minimax_api_key_here

# Server 設定
HOST=0.0.0.0
PORT=8000

# MiniMax API Base URL (Anthropic 相容介面)
MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# 自動重載設定（開發模式）
# 注意：開啟後，檔案變更時會自動重啟 server，可能中斷進行中的長請求
# 生產環境建議設為 false
RELOAD=false

# 注意：超時設定已改為程式碼內建配置（針對長請求優化）
# - 建立連線: 10 秒
# - 讀取資料: 30 分鐘（適合長時間思考的請求）
# - 寫入資料: 30 秒
# 如需調整請修改 main.py 中的 TIMEOUT 設定
